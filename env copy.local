# JWT Configuration
# Generate a strong random secret (e.g., openssl rand -base64 32)
JWT_SIGNING_SECRET=my4Q890wD2hpbOppdC6i/H+mPu5tSqpDrzuwHV5P2jc=

# Application Configuration
