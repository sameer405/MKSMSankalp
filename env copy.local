SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNxa3lrdGVvZ2RucHJxeWptZ3ZyIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2MTYyNjcwNywiZXhwIjoyMDc3MjAyNzA3fQ.WttBHm-1vyYwn-LYlPSBn-jYF8sBPA8wVZfaqeRjVsQ
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNxa3lrdGVvZ2RucHJxeWptZ3ZyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjE2MjY3MDcsImV4cCI6MjA3NzIwMjcwN30.LJz_ucpHdISYAYMSzaH_QYuTs8M6hsCNA_9U9wBTYaM

# Airtable Configuration
